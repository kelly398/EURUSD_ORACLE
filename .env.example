# Preserve your existing .env; this file contains examples, never real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/eurusd_oracle

# Request an application-specific key while signed in to your FRED account:
# https://fred.stlouisfed.org/docs/api/api_key.html
# Set this in the real local .env. Do not paste the key into chat or commit it.
FRED_API_KEY=

# Optional absolute path for the existing Windows MT5 provider.
MT5_TERMINAL_PATH=
